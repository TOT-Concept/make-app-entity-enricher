  {
    "name": "prompts",
    "type": "array",
    "label": "Per-prompt details",
    "spec": {
      "type": "collection",
      "spec": [
        { "name": "id", "type": "uuid", "label": "Prompt ID" },
        { "name": "expertise_key", "type": "text", "label": "Expertise key" },
        { "name": "expertise_name", "type": "text", "label": "Expertise name" },
        { "name": "sequence_order", "type": "uinteger", "label": "Sequence order" },
        { "name": "prompt_used", "type": "text", "label": "Prompt sent" },
        { "name": "system_prompt_used", "type": "text", "label": "System prompt" },
        { "name": "raw_response", "type": "text", "label": "Raw response" },
        { "name": "structured_output", "type": "any", "label": "Structured output" },
        { "name": "processing_time_ms", "type": "uinteger", "label": "Processing time (ms)" },
        { "name": "input_tokens", "type": "uinteger", "label": "Input tokens" },
        { "name": "output_tokens", "type": "uinteger", "label": "Output tokens" },
        { "name": "cost_usd", "type": "number", "label": "Cost (USD)" },
        { "name": "success", "type": "boolean", "label": "Success" },
        { "name": "error_message", "type": "text", "label": "Error message" },
        { "name": "attempts", "type": "uinteger", "label": "Attempts" },
        { "name": "web_search_calls", "type": "uinteger", "label": "Web search calls" }
      ]
    }
  },
  {
    "name": "validation_errors",
    "type": "array",
    "label": "Validation errors",
    "spec": { "type": "text" }
