[
  {
    "name": "data",
    "type": "buffer",
    "label": "File",
    "help": "The file's raw bytes. Map a binary/file output from an upstream module — e.g. HTTP ▸ 'Get a File', Google Drive ▸ 'Download a File', or HTTP ▸ 'Make a request' with Parse response = No. Do NOT use 'Make a request' with parsing on: it turns XML/JSON into a collection, which can't be cast to a buffer (you'll get 'Value can't be casted as buffer for parameter data').",
    "required": true,
    "semantic": "file:data"
  },
  {
    "name": "fileName",
    "type": "filename",
    "label": "File name",
    "help": "Original file name including extension (e.g. report.pdf). The extension matters — the server sniffs the format and applies the matching document policy.",
    "required": true,
    "semantic": "file:name"
  }
]
