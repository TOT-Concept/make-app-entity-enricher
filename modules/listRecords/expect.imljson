[
  {
    "name": "limit",
    "type": "uinteger",
    "label": "Limit",
    "help": "Maximum number of records to return (1–100).",
    "default": 20,
    "validate": { "min": 1, "max": 100 }
  },
  {
    "name": "recordType",
    "type": "select",
    "label": "Type",
    "help": "Filter by record type. Leave 'Any' to include all types.",
    "default": "any",
    "options": [
      { "label": "Any", "value": "any" },
      { "label": "Enrichment", "value": "enrichment" },
      { "label": "Schema generation", "value": "schema_generation" },
      { "label": "Schema edit", "value": "schema_edit" },
      { "label": "Playground", "value": "playground" },
      { "label": "Sample generation", "value": "sample_generation" }
    ]
  },
  {
    "name": "successOnly",
    "type": "boolean",
    "label": "Successful only",
    "help": "Return only records where the enrichment succeeded.",
    "default": false
  },
  {
    "name": "search",
    "type": "text",
    "label": "Search",
    "help": "Free-text search across record fields.",
    "advanced": true
  }
]
