{
  "url": "api/records",
  "headers": {
    "x-api-key": "{{connection.apiKey}}"
  },
  "method": "GET",
  "qs": {
    "limit": "{{ifempty(parameters.limit, 20)}}",
    "type": "{{if(parameters.recordType == 'any', null, parameters.recordType)}}",
    "success": "{{if(parameters.successOnly, true, null)}}",
    "search": "{{parameters.search}}"
  },
  "response": {
    "iterate": "{{body.records}}",
    "output": "{{item}}"
  }
}
