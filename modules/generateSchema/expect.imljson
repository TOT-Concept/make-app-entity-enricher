[
  {
    "name": "entitySamples",
    "type": "text",
    "label": "Sample data (JSON)",
    "help": "One sample object, e.g. {\"title\":\"Fight Club\"}, or a JSON array of several samples of the SAME entity type, e.g. [{\"title\":\"Fight Club\"},{\"title\":\"Heat\"}]. With several samples the schema covers the union of their fields: a field missing or null in any sample becomes nullable, and distinct observed values become the property examples. You can also map a JSON string from a previous module. 📖 [Full module guide](https://entityenricher.ai/docs/integrations/make)",
    "required": true
  },
  {
    "name": "model",
    "type": "text",
    "label": "Model",
    "help": "'auto' (default) lets the server pick the org's default schema-generation model.",
    "default": "auto",
    "advanced": true
  },
  {
    "name": "generateSemanticIds",
    "type": "boolean",
    "label": "Generate semantic IDs",
    "help": "Add a semantic_id property to every object with a key source (enables embedding-based entity resolution).",
    "default": false,
    "advanced": true
  },
  {
    "name": "commonalityThreshold",
    "type": "number",
    "label": "Commonality threshold",
    "help": "Minimum share (0..1) of the combined field set every sample must cover — mixed entity types fail with a 400 before any LLM call. Default 0.5.",
    "default": 0.5,
    "advanced": true
  },
  {
    "name": "language",
    "type": "text",
    "label": "Schema language (optional)",
    "help": "Language the schema describes ITSELF in \u2014 type names, entity/property descriptions, expertise names and descriptions (e.g. 'fr'). Property names always come from the samples and are never translated. Leave empty to follow the language the sample's property names are written in.",
    "advanced": true
  },
  {
    "name": "timeoutSeconds",
    "type": "uinteger",
    "label": "Timeout (seconds)",
    "help": "How long the module waits before failing with a timeout error. Bounded [10, 900].",
    "default": 300,
    "validate": {
      "min": 10,
      "max": 900
    },
    "advanced": true
  }
]
