  "sql": "INSERT INTO \"company\" (\"name\", \"country\", \"founded_year\", \"_sync_revision\") VALUES ('ACME', 'FR', 1998, 7)\nON CONFLICT (\"name\", \"country\") DO UPDATE SET \"founded_year\" = EXCLUDED.\"founded_year\", \"_sync_revision\" = EXCLUDED.\"_sync_revision\", \"_updated_at\" = now()\nWHERE \"company\".\"_sync_revision\" < EXCLUDED.\"_sync_revision\"\n  AND (\"company\".\"founded_year\") IS DISTINCT FROM (EXCLUDED.\"founded_year\");",
