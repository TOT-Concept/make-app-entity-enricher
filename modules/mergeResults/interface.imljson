[
  { "name": "success", "type": "boolean", "label": "Success" },
  { "name": "merged_result", "type": "any", "label": "Merged result (shape varies per schema)" },
  { "name": "record_id", "type": "uuid", "label": "Arbitration record ID" },
  { "name": "processing_time_ms", "type": "uinteger", "label": "Processing time (ms)" },
  { "name": "cost_usd", "type": "number", "label": "Cost (USD, null if rule-based)" },
  { "name": "input_tokens", "type": "uinteger", "label": "Input tokens (null if rule-based)" },
  { "name": "output_tokens", "type": "uinteger", "label": "Output tokens (null if rule-based)" },
  {
    "name": "conflict_report",
    "type": "collection",
    "label": "Conflict report",
    "spec": [
      { "name": "agreed_fields", "type": "uinteger", "label": "Agreed fields" },
      { "name": "conflicted_fields", "type": "uinteger", "label": "Conflicted fields" },
      { "name": "total_fields", "type": "uinteger", "label": "Total fields" }
    ]
  },
  { "name": "error_message", "type": "text", "label": "Error message (if failed)" },
  {
    "name": "validation_warnings",
    "type": "array",
    "label": "Validation warnings",
    "spec": { "type": "text" }
  },
  {
    "name": "database",
    "type": "collection",
    "label": "Database sync outcome (when the schema has a registered database)",
    "spec": [
      { "name": "saved", "type": "boolean", "label": "Saved to the entity layer (false = will NOT reach your database)" },
      { "name": "reason", "type": "text", "label": "Rejection reason (when not saved)" },
      {
        "name": "missing_fields",
        "type": "array",
        "label": "Required fields that came back empty",
        "spec": { "type": "text" }
      },
      {
        "name": "skipped_items",
        "type": "array",
        "label": "Array items dropped by a skip_row database (own required fields empty)",
        "spec": { "type": "text" }
      },
      {
        "name": "key_collisions",
        "type": "array",
        "label": "List items that claimed a database key an earlier sibling already had (only the first was written)",
        "spec": {
          "type": "collection",
          "spec": [
            { "name": "entity_type", "type": "text", "label": "Entity type" },
            { "name": "path", "type": "text", "label": "Path of the dropped item" },
            { "name": "kept", "type": "any", "label": "Identifying values of the item kept" },
            { "name": "dropped", "type": "any", "label": "Identifying values of the item dropped" }
          ]
        }
      },
      { "name": "entity_count", "type": "uinteger", "label": "Entities written" },
      { "name": "delta_count", "type": "uinteger", "label": "SQL deltas queued" }
    ]
  }
]
