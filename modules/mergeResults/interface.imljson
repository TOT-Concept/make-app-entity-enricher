[
  { "name": "success", "type": "boolean", "label": "Success" },
  { "name": "merged_result", "type": "any", "label": "Merged result (shape varies per schema)" },
  { "name": "record_id", "type": "uuid", "label": "Arbitration record ID" },
  { "name": "processing_time_ms", "type": "uinteger", "label": "Processing time (ms)" },
  { "name": "cost_usd", "type": "number", "label": "Cost (USD, null if rule-based)" },
  { "name": "input_tokens", "type": "uinteger", "label": "Input tokens (null if rule-based)" },
  { "name": "output_tokens", "type": "uinteger", "label": "Output tokens (null if rule-based)" },
  {
    "name": "conflict_report",
    "type": "collection",
    "label": "Conflict report",
    "spec": [
      { "name": "agreed_fields", "type": "uinteger", "label": "Agreed fields" },
      { "name": "conflicted_fields", "type": "uinteger", "label": "Conflicted fields" },
      { "name": "total_fields", "type": "uinteger", "label": "Total fields" }
    ]
  },
  { "name": "error_message", "type": "text", "label": "Error message (if failed)" },
  {
    "name": "validation_warnings",
    "type": "array",
    "label": "Validation warnings",
    "spec": { "type": "text" }
  }
]
