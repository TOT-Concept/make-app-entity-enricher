[
  {
    "name": "job_id",
    "type": "uuid",
    "label": "Job ID"
  },
  {
    "name": "success",
    "type": "boolean",
    "label": "Success"
  },
  {
    "name": "is_fused",
    "type": "boolean",
    "label": "Is fused result"
  },
  {
    "name": "result",
    "type": "any",
    "label": "Enriched result (shape varies per schema)"
  },
  {
    "name": "record_id",
    "type": "uuid",
    "label": "Record ID"
  },
  {
    "name": "model",
    "type": "text",
    "label": "Model (single-model only)"
  },
  {
    "name": "source_models",
    "type": "array",
    "label": "Source models (fused only)",
    "spec": {
      "type": "text"
    }
  },
  {
    "name": "cost_usd",
    "type": "number",
    "label": "Cost (USD)"
  },
  {
    "name": "input_tokens",
    "type": "uinteger",
    "label": "Input tokens"
  },
  {
    "name": "output_tokens",
    "type": "uinteger",
    "label": "Output tokens"
  },
  {
    "name": "processing_time_ms",
    "type": "uinteger",
    "label": "Processing time (ms)"
  },
  {
    "name": "fusion",
    "type": "collection",
    "label": "Fusion summary (fused only)",
    "spec": [
      {
        "name": "agreed_fields",
        "type": "uinteger",
        "label": "Agreed fields"
      },
      {
        "name": "conflicted_fields",
        "type": "uinteger",
        "label": "Conflicted fields"
      },
      {
        "name": "total_fields",
        "type": "uinteger",
        "label": "Total fields"
      },
      {
        "name": "method",
        "type": "text",
        "label": "How conflicts were resolved: llm | rule_based (rule_based despite an arbitration model = that call failed and the deterministic rules stood)"
      },
      {
        "name": "arbitration_model",
        "type": "text",
        "label": "Model whose arbitration decisions were applied (empty on a purely rule-based merge)"
      }
    ]
  },
  {
    "name": "database",
    "type": "collection",
    "label": "Database sync outcome (when the schema has a registered database)",
    "spec": [
      {
        "name": "saved",
        "type": "boolean",
        "label": "Saved to the entity layer (false = will NOT reach your database)"
      },
      {
        "name": "status",
        "type": "text",
        "label": "Write status: saved | partial (some rows dropped, nothing re-sends them) | rejected"
      },
      {
        "name": "reason",
        "type": "text",
        "label": "Why the write was not whole (rejection cause, or what was dropped when partial)"
      },
      {
        "name": "missing_fields",
        "type": "array",
        "label": "Required fields that came back empty (the cause of the rejection, or of every dropped item)",
        "spec": {
          "type": "text"
        }
      },
      {
        "name": "skipped_items",
        "type": "array",
        "label": "Array items dropped by a skip_children database (own required fields empty)",
        "spec": {
          "type": "text"
        }
      },
      {
        "name": "detached_references",
        "type": "array",
        "label": "Shared 1-1 references detached by a skip_children database (target's own required fields empty — target not written, saved row links to nothing there)",
        "spec": {
          "type": "text"
        }
      },
      {
        "name": "key_collisions",
        "type": "array",
        "label": "List items dropped because a later sibling of the same list claimed their database key (last one wins); kind says whether values were lost",
        "spec": {
          "type": "collection",
          "spec": [
            {
              "name": "entity_type",
              "type": "text",
              "label": "Entity type"
            },
            {
              "name": "path",
              "type": "text",
              "label": "Path of the dropped item"
            },
            {
              "name": "kept_path",
              "type": "text",
              "label": "Path of the sibling written in its place (the last claimant)"
            },
            {
              "name": "kind",
              "type": "text",
              "label": "duplicate (same values, nothing lost) or conflicting (some non-key value differs and is lost — the key may need a discriminating property)"
            },
            {
              "name": "kept",
              "type": "any",
              "label": "Identifying values of the item kept"
            },
            {
              "name": "dropped",
              "type": "any",
              "label": "Identifying values of the item dropped"
            },
            {
              "name": "differing_fields",
              "type": "array",
              "label": "Properties both items answered differently (empty on a duplicate)",
              "spec": {
                "type": "text"
              }
            }
          ]
        }
      },
      {
        "name": "identity_merges",
        "type": "array",
        "label": "Objects identified as an existing concept minted from different text (a root entity here OWNS that row)",
        "spec": {
          "type": "collection",
          "spec": [
            {
              "name": "json_path",
              "type": "text",
              "label": "Path of the object (empty for the enriched entity itself)"
            },
            {
              "name": "text",
              "type": "text",
              "label": "Identity text this object composed"
            },
            {
              "name": "matched_text",
              "type": "text",
              "label": "Canonical text of the concept it joined"
            },
            {
              "name": "similarity",
              "type": "number",
              "label": "Similarity of the match (empty for a deterministic code/token match)"
            },
            {
              "name": "concept_id",
              "type": "text",
              "label": "Concept ID"
            }
          ]
        }
      },
      {
        "name": "shared_entity_conflicts",
        "type": "array",
        "label": "Shared rows this run overwrote while another parent still links to them",
        "spec": {
          "type": "collection",
          "spec": [
            {
              "name": "entity_type",
              "type": "text",
              "label": "Entity type"
            },
            {
              "name": "path",
              "type": "text",
              "label": "Path of the shared child"
            },
            {
              "name": "keys",
              "type": "any",
              "label": "Identifying values of the shared row"
            },
            {
              "name": "other_parents",
              "type": "uinteger",
              "label": "Other entities linking to that row"
            },
            {
              "name": "fields",
              "type": "array",
              "label": "Overwritten properties",
              "spec": {
                "type": "collection",
                "spec": [
                  {
                    "name": "property",
                    "type": "text",
                    "label": "Property"
                  },
                  {
                    "name": "previous",
                    "type": "text",
                    "label": "Value stored by the other parent"
                  },
                  {
                    "name": "incoming",
                    "type": "text",
                    "label": "Value written over it"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "identity_underidentifies",
        "type": "array",
        "label": "Namesake overwrites: every compared value disagreed with the stored row — the identity keys do not tell these objects apart",
        "spec": {
          "type": "collection",
          "spec": [
            {
              "name": "entity_type",
              "type": "text",
              "label": "Entity type"
            },
            {
              "name": "path",
              "type": "text",
              "label": "Path of the shared child"
            },
            {
              "name": "keys",
              "type": "any",
              "label": "Identity values both objects share"
            },
            {
              "name": "semantic_id",
              "type": "text",
              "label": "Concept now holding both objects' state"
            },
            {
              "name": "compared_fields",
              "type": "uinteger",
              "label": "Fields both payloads answered — all disagreed"
            }
          ]
        }
      },
      {
        "name": "entity_keys",
        "type": "any",
        "label": "Stored key column values of the saved row (correlate by these, not by input text)"
      },
      {
        "name": "entity_count",
        "type": "uinteger",
        "label": "Entities written"
      },
      {
        "name": "delta_count",
        "type": "uinteger",
        "label": "SQL deltas queued"
      }
    ]
  },
  {
    "name": "failed_models",
    "type": "array",
    "label": "Failed models (set when a requested model produced no result)",
    "spec": {
      "type": "collection",
      "spec": [
        {
          "name": "model",
          "type": "text",
          "label": "Model"
        },
        {
          "name": "error_message",
          "type": "text",
          "label": "Error message"
        }
      ]
    }
  },
  {
    "name": "per_model_results",
    "type": "array",
    "label": "Per-model results (when requested)",
    "spec": {
      "type": "collection",
      "spec": [
        {
          "name": "model",
          "type": "text",
          "label": "Model"
        },
        {
          "name": "success",
          "type": "boolean",
          "label": "Success"
        },
        {
          "name": "partial_success",
          "type": "boolean",
          "label": "Partial success"
        },
        {
          "name": "result",
          "type": "any",
          "label": "Result"
        },
        {
          "name": "error_message",
          "type": "text",
          "label": "Error message"
        },
        {
          "name": "error_code",
          "type": "text",
          "label": "Error code (model_retired / rate_limited / context_length_exceeded / provider_timeout)"
        },
        {
          "name": "record_id",
          "type": "uuid",
          "label": "Record ID"
        },
        {
          "name": "cost_usd",
          "type": "number",
          "label": "Cost (USD)"
        },
        {
          "name": "input_tokens",
          "type": "uinteger",
          "label": "Input tokens"
        },
        {
          "name": "output_tokens",
          "type": "uinteger",
          "label": "Output tokens"
        },
        {
          "name": "processing_time_ms",
          "type": "uinteger",
          "label": "Processing time (ms)"
        },
        {
          "name": "cancelled",
          "type": "boolean",
          "label": "Cancelled"
        }
      ]
    }
  },
  {
    "name": "profile_limits",
    "type": "collection",
    "label": "Profile limits (when requested)",
    "spec": [
      {
        "name": "can_view_prompts",
        "type": "boolean",
        "label": "Can view prompts"
      },
      {
        "name": "daily_prompt_limit",
        "type": "uinteger",
        "label": "Daily prompt limit"
      },
      {
        "name": "weekly_prompt_limit",
        "type": "uinteger",
        "label": "Weekly prompt limit"
      },
      {
        "name": "monthly_prompt_limit",
        "type": "uinteger",
        "label": "Monthly prompt limit"
      },
      {
        "name": "max_record_retention_days",
        "type": "uinteger",
        "label": "Max record retention (days)"
      },
      {
        "name": "max_delta_retention_days",
        "type": "uinteger",
        "label": "Max delta retention (days)"
      },
      {
        "name": "max_concurrent_jobs",
        "type": "uinteger",
        "label": "Max concurrent jobs"
      },
      {
        "name": "max_models_per_enrichment",
        "type": "uinteger",
        "label": "Max models per enrichment"
      },
      {
        "name": "max_languages",
        "type": "uinteger",
        "label": "Max languages"
      }
    ]
  }
]
