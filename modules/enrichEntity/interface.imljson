[
  {
    "name": "job_id",
    "type": "uuid",
    "label": "Job ID"
  },
  {
    "name": "success",
    "type": "boolean",
    "label": "Success"
  },
  {
    "name": "is_fused",
    "type": "boolean",
    "label": "Is fused result"
  },
  {
    "name": "result",
    "type": "any",
    "label": "Enriched result (shape varies per schema)"
  },
  {
    "name": "record_id",
    "type": "uuid",
    "label": "Record ID"
  },
  {
    "name": "model",
    "type": "text",
    "label": "Model (single-model only)"
  },
  {
    "name": "source_models",
    "type": "array",
    "label": "Source models (fused only)",
    "spec": {
      "type": "text"
    }
  },
  {
    "name": "cost_usd",
    "type": "number",
    "label": "Cost (USD)"
  },
  {
    "name": "input_tokens",
    "type": "uinteger",
    "label": "Input tokens"
  },
  {
    "name": "output_tokens",
    "type": "uinteger",
    "label": "Output tokens"
  },
  {
    "name": "processing_time_ms",
    "type": "uinteger",
    "label": "Processing time (ms)"
  },
  {
    "name": "fusion",
    "type": "collection",
    "label": "Fusion summary (fused only)",
    "spec": [
      {
        "name": "agreed_fields",
        "type": "uinteger",
        "label": "Agreed fields"
      },
      {
        "name": "conflicted_fields",
        "type": "uinteger",
        "label": "Conflicted fields"
      },
      {
        "name": "total_fields",
        "type": "uinteger",
        "label": "Total fields"
      }
    ]
  },
  {
    "name": "database",
    "type": "collection",
    "label": "Database sync outcome (when the schema has a registered database)",
    "spec": [
      {
        "name": "saved",
        "type": "boolean",
        "label": "Saved to the entity layer (false = will NOT reach your database)"
      },
      {
        "name": "status",
        "type": "text",
        "label": "Write status: saved | partial (some rows dropped, nothing re-sends them) | rejected"
      },
      {
        "name": "reason",
        "type": "text",
        "label": "Why the write was not whole (rejection cause, or what was dropped when partial)"
      },
      {
        "name": "missing_fields",
        "type": "array",
        "label": "Required fields that came back empty (the cause of the rejection, or of every dropped item)",
        "spec": {
          "type": "text"
        }
      },
      {
        "name": "skipped_items",
        "type": "array",
        "label": "Array items dropped by a skip_row database (own required fields empty)",
        "spec": {
          "type": "text"
        }
      },
      {
        "name": "key_collisions",
        "type": "array",
        "label": "List items that claimed a database key an earlier sibling already had (only the first was written)",
        "spec": {
          "type": "collection",
          "spec": [
            {
              "name": "entity_type",
              "type": "text",
              "label": "Entity type"
            },
            {
              "name": "path",
              "type": "text",
              "label": "Path of the dropped item"
            },
            {
              "name": "kept",
              "type": "any",
              "label": "Identifying values of the item kept"
            },
            {
              "name": "dropped",
              "type": "any",
              "label": "Identifying values of the item dropped"
            }
          ]
        }
      },
      {
        "name": "shared_entity_conflicts",
        "type": "array",
        "label": "Shared rows this run overwrote while another parent still links to them",
        "spec": {
          "type": "collection",
          "spec": [
            {
              "name": "entity_type",
              "type": "text",
              "label": "Entity type"
            },
            {
              "name": "path",
              "type": "text",
              "label": "Path of the shared child"
            },
            {
              "name": "keys",
              "type": "any",
              "label": "Identifying values of the shared row"
            },
            {
              "name": "other_parents",
              "type": "uinteger",
              "label": "Other entities linking to that row"
            },
            {
              "name": "fields",
              "type": "array",
              "label": "Overwritten properties",
              "spec": {
                "type": "collection",
                "spec": [
                  {
                    "name": "property",
                    "type": "text",
                    "label": "Property"
                  },
                  {
                    "name": "previous",
                    "type": "text",
                    "label": "Value stored by the other parent"
                  },
                  {
                    "name": "incoming",
                    "type": "text",
                    "label": "Value written over it"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "entity_count",
        "type": "uinteger",
        "label": "Entities written"
      },
      {
        "name": "delta_count",
        "type": "uinteger",
        "label": "SQL deltas queued"
      }
    ]
  },
  {
    "name": "failed_models",
    "type": "array",
    "label": "Failed models (set when a requested model produced no result)",
    "spec": {
      "type": "collection",
      "spec": [
        {
          "name": "model",
          "type": "text",
          "label": "Model"
        },
        {
          "name": "error_message",
          "type": "text",
          "label": "Error message"
        }
      ]
    }
  },
  {
    "name": "per_model_results",
    "type": "array",
    "label": "Per-model results (when requested)",
    "spec": {
      "type": "collection",
      "spec": [
        {
          "name": "model",
          "type": "text",
          "label": "Model"
        },
        {
          "name": "success",
          "type": "boolean",
          "label": "Success"
        },
        {
          "name": "partial_success",
          "type": "boolean",
          "label": "Partial success"
        },
        {
          "name": "result",
          "type": "any",
          "label": "Result"
        },
        {
          "name": "error_message",
          "type": "text",
          "label": "Error message"
        },
        {
          "name": "error_code",
          "type": "text",
          "label": "Error code (model_retired / rate_limited / context_length_exceeded / provider_timeout)"
        },
        {
          "name": "record_id",
          "type": "uuid",
          "label": "Record ID"
        },
        {
          "name": "cost_usd",
          "type": "number",
          "label": "Cost (USD)"
        },
        {
          "name": "input_tokens",
          "type": "uinteger",
          "label": "Input tokens"
        },
        {
          "name": "output_tokens",
          "type": "uinteger",
          "label": "Output tokens"
        },
        {
          "name": "processing_time_ms",
          "type": "uinteger",
          "label": "Processing time (ms)"
        },
        {
          "name": "cancelled",
          "type": "boolean",
          "label": "Cancelled"
        }
      ]
    }
  },
  {
    "name": "profile_limits",
    "type": "collection",
    "label": "Profile limits (when requested)",
    "spec": [
      {
        "name": "can_view_prompts",
        "type": "boolean",
        "label": "Can view prompts"
      },
      {
        "name": "daily_prompt_limit",
        "type": "uinteger",
        "label": "Daily prompt limit"
      },
      {
        "name": "weekly_prompt_limit",
        "type": "uinteger",
        "label": "Weekly prompt limit"
      },
      {
        "name": "monthly_prompt_limit",
        "type": "uinteger",
        "label": "Monthly prompt limit"
      },
      {
        "name": "max_record_results",
        "type": "uinteger",
        "label": "Max record results"
      },
      {
        "name": "max_concurrent_jobs",
        "type": "uinteger",
        "label": "Max concurrent jobs"
      },
      {
        "name": "max_models_per_enrichment",
        "type": "uinteger",
        "label": "Max models per enrichment"
      },
      {
        "name": "max_languages",
        "type": "uinteger",
        "label": "Max languages"
      }
    ]
  }
]
