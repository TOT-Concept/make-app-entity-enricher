{
  "url": "{{connection.baseUrl}}/api/single/enrich/sync",
  "method": "POST",
  "body": {
    "entity_data": "{{parameters.entityData}}",
    "schema_id": "{{parameters.schemaId}}",
    "models": "{{parameters.models}}",
    "languages": "{{ifempty(parameters.languages, parsedate('en'))}}",
    "strategy": "{{ifempty(parameters.strategy, 'single_pass')}}",
    "classification_model": "{{parameters.classificationModel}}",
    "arbitration_model": "{{parameters.arbitrationModel}}",
    "enable_web_search": "{{eq(parameters.enableWebSearch, 'on')}}",
    "timeout_seconds": "{{ifempty(parameters.timeoutSeconds, 300)}}",
    "include_per_model_results": "{{ifempty(parameters.includePerModelResults, false)}}",
    "include_profile_limits": "{{ifempty(parameters.includeProfileLimits, false)}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
