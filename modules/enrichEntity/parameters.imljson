[
  {
    "name": "schemaId",
    "type": "select",
    "label": "Schema",
    "help": "Saved schema that defines the enrichment output structure.",
    "required": true,
    "options": {
      "store": "rpc://getSchemas",
      "label": "{{if(item.is_pinned, '\ud83d\udccc ' + item.name, item.name)}}",
      "value": "{{item.id}}"
    }
  },
  {
    "name": "models",
    "type": "array",
    "label": "Models",
    "help": "Pick one or more LLM models. With 2+ models the results are automatically fused. Plan limits are enforced server-side; pick fewer if you exceed your quota.",
    "required": true,
    "spec": {
      "type": "select",
      "options": {
        "store": "rpc://getModels",
        "label": "{{item.display_name}}{{if(item.input_price, ' (in $' + item.input_price + '/M, out $' + item.output_price + '/M)', '')}}",
        "value": "{{item.key}}"
      }
    }
  },
  {
    "name": "languages",
    "type": "array",
    "label": "Languages",
    "help": "Languages to populate for multilingual fields. Defaults to English only.",
    "default": [
      "en"
    ],
    "spec": {
      "type": "select",
      "options": {
        "store": "rpc://getLanguages",
        "label": "{{item.label}}",
        "value": "{{item.code}}"
      }
    }
  },
  {
    "name": "strategy",
    "type": "select",
    "label": "Strategy",
    "help": "How the LLM is prompted: single_pass (one call), expert_domains (one call grouped by expertise), multi_expertise (parallel calls per expertise).",
    "default": "single_pass",
    "options": {
      "store": "rpc://getStrategies",
      "label": "{{item.name}} \u2014 {{item.description}}",
      "value": "{{item.name}}"
    }
  },
  {
    "name": "entityData",
    "type": "any",
    "label": "Entity data (JSON)",
    "help": "The entity to enrich. Map a previous module's output here, or pass an object literal. Must contain at least one of the schema's search-key properties (the API returns 400 with a hint if not).",
    "required": true
  },
  {
    "name": "classificationModel",
    "type": "select",
    "label": "Classification model (optional)",
    "help": "Run a fast pre-flight classification to detect entity-type mismatches before enrichment. If the entity is mismatched/unknown/ambiguous, the module fails with a 'classification_warning' DataError instead of producing hallucinated data.",
    "options": {
      "store": "rpc://getClassificationModels",
      "label": "{{item.display_name}}",
      "value": "{{item.key}}"
    }
  },
  {
    "name": "arbitrationModel",
    "type": "select",
    "label": "Arbitration model (optional)",
    "help": "Used to LLM-arbitrate field conflicts during fusion. Leave empty for deterministic rule-based merging.",
    "options": {
      "store": "rpc://getArbitrationModels",
      "label": "{{item.display_name}}",
      "value": "{{item.key}}"
    }
  },
  {
    "name": "enableWebSearch",
    "type": "select",
    "label": "Web search",
    "help": "Enable provider-builtin web search for selected models that support it. Disabled if no selected model declares supports_web_search.",
    "default": "off",
    "options": {
      "store": "rpc://getWebSearchOptions",
      "label": "{{item.label}}",
      "parameters": [
        "models"
      ],
      "value": "{{item.value}}"
    }
  },
  {
    "name": "timeoutSeconds",
    "type": "uinteger",
    "label": "Timeout (seconds)",
    "help": "How long the module waits before failing with a timeout error. Bounded [10, 900].",
    "default": 300,
    "validate": {
      "min": 10,
      "max": 900
    },
    "advanced": true
  },
  {
    "name": "includePerModelResults",
    "type": "boolean",
    "label": "Include per-model results",
    "help": "When true, the response includes the full per-model result list alongside the fused result.",
    "default": false,
    "advanced": true
  },
  {
    "name": "includeProfileLimits",
    "type": "boolean",
    "label": "Include profile limits",
    "help": "When true, the response includes the org's profile_limits \u2014 useful for downstream branching on remaining quota.",
    "default": false,
    "advanced": true
  }
]
