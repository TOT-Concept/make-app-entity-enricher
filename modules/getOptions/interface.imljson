        "label": "Enrichment default",
        "spec": [
          { "name": "key", "type": "text", "label": "Composite key (provider::model)" },
          { "name": "display_name", "type": "text", "label": "Display name" },
          { "name": "overall", "type": "number", "label": "Overall benchmark score (0-1)" },
          { "name": "source", "type": "text", "label": "Score source (organization | global)" },
          { "name": "pinned", "type": "boolean", "label": "Pinned org default" }
        ]
      },
      {
        "name": "schema_generation",
        "type": "collection",
