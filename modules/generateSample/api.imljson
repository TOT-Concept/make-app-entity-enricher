{
  "url": "api/schema/sample/generate/sync",
  "method": "POST",
  "body": {
    "request": "{{parameters.request}}",
    "sample_count": "{{ifempty(parameters.sampleCount, 1)}}",
    "typical_objects": "{{parameters.typicalObjects}}",
    "naming_convention": "{{ifempty(parameters.namingConvention, 'auto')}}",
    "attachment_ids": "{{parameters.attachmentIds}}",
    "enable_web_search": "{{ifempty(parameters.enableWebSearch, 'off') == 'on'}}",
    "language": "{{ifempty(parameters.language, 'auto')}}",
    "model": "{{ifempty(parameters.model, 'auto')}}",
    "timeout_seconds": "{{ifempty(parameters.timeoutSeconds, 300)}}"
  }
}
