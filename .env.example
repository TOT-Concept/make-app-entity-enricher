# Copy to .env.local and fill in your dev app's Make-assigned name.
# .env.local is gitignored; this file is committed as a template.
#
# To get the suffixed name, either:
#   1. List your apps:  pnpm run mk:apps
#   2. Or, on first creation, capture the `name` from:
#        pnpm exec make-cli sdk-apps create --name=entity-enricher --label='Entity Enricher' ...
#      Make auto-suffixes (e.g. entity-enricher-3ebi2k) for global uniqueness.

MAKE_APP_NAME=entity-enricher-XXXXXX
MAKE_APP_VERSION=1

# Required by `pnpm run pull-scenarios` to know which team to scan.
# Find via: pnpm exec make-cli teams list --organization-id=<org-id>
MAKE_TEAM_ID=
