{
  "url": "api/enrichment/options",
  "method": "GET",
  "response": {
    "temp": {
      "selectedModels": "{{ifempty(parameters.models, emptyarray)}}",
      "anyStrict": "{{contains(map(body.models, 'supports_strict_structured_output', 'key', parameters.models), true)}}"
    },
    "output": [
      {
        "label": "Off",
        "value": "off"
      },
      {
        "label": "{{if(temp.anyStrict, 'On — constrained decoding (no drift)', 'On — no selected model supports strict structured output')}}",
        "value": "on"
      }
    ]
  }
}
