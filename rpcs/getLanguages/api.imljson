{
  "url": "api/enrichment/options",
  "headers": {
    "x-api-key": "{{connection.apiKey}}"
  },
  "method": "GET",
  "response": {
    "iterate": {
      "container": "{{keys(body.languages)}}"
    },
    "output": {
      "code": "{{item}}",
      "label": "{{get(body.languages, item)}}"
    }
  }
}
