{
  "url": "api/enrichment/options",
  "method": "GET",
  "response": {
    "output": {
      "key": "{{item.key}}",
      "label": "{{item.display_name}}{{if(item.benchmark_scores.enrichment.overall, ' ★' + formatNumber(item.benchmark_scores.enrichment.overall * 100, 0) + ' (Q' + formatNumber(item.benchmark_scores.enrichment.quality * 100, 0) + ' S' + formatNumber(item.benchmark_scores.enrichment.speed * 100, 0) + ' C' + formatNumber(item.benchmark_scores.enrichment.cost * 100, 0) + ')', '')}}{{if(item.input_price, ', in $' + formatNumber(item.input_price,2) + ', out $' + formatNumber(item.output_price,2), '')}}{{if(item.supports_web_search, ' 🌍', '')}}"
    },
    "iterate": {
      "container": "{{body.models}}",
      "condition": "{{item.is_available && (!item.processing_disabled || !item.processing_disabled.enrichment)}}"
    }
  }
}
