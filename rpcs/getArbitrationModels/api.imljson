{
  "url": "api/enrichment/options",
  "headers": {
    "x-api-key": "{{connection.apiKey}}"
  },
  "method": "GET",
  "response": {
    "output": {
      "key": "{{item.key}}",
      "label": "{{item.display_name}}{{if(item.input_price, ', in $' + formatNumber(item.input_price,2) + ' out $' + formatNumber(item.output_price,2), '')}}{{if(item.supports_web_search, ' 🌍', '')}}"
    },
    "iterate": {
      "container": "{{body.models}}",
      "condition": "{{item.is_available && (!item.processing_disabled || !item.processing_disabled.arbitration)}}"
    }
  }
}

