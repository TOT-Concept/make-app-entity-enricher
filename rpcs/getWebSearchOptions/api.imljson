{
  "url": "api/enrichment/options",
  "method": "GET",
  "response": {
    "temp": {
      "selectedModels": "{{ifempty(parameters.models, emptyarray)}}",
      "anyWebSearch": "{{contains(map(body.models, 'supports_web_search', 'key', parameters.models), true)}}"
    },
    "output": [
      {
        "label": "Off",
        "value": "off"
      },
      {
        "label": "{{if(temp.anyWebSearch, 'On — server-side web search', 'On — no selected model supports web search')}}",
        "value": "on"
      }
    ]
  }
}
