{
  "url": "api/enrichment/options",
  "method": "GET",
  "response": {
    "temp": {
      "selectedModels": "{{ifempty(parameters.models, emptyarray)}}",
      "anyResponseSchema": "{{contains(map(body.models, 'supports_response_schema', 'key', parameters.models), true)}}"
    },
    "output": [
      {
        "label": "Off",
        "value": "off"
      },
      {
        "label": "{{if(temp.anyResponseSchema, 'On — provider response-schema channel', 'On — no selected model supports response schema')}}",
        "value": "on"
      }
    ]
  }
}
